  axes{
    climb{
      relative:b=no
    }

    elevator{
      innerDeadzone:r=0.05
      nonlinearity:r=0
    }

    rudder{
      innerDeadzone:r=0.05
      nonlinearity:r=0
    }

    sensor_cue_x{
      innerDeadzone:r=0
    }

    sensor_cue_y{
      innerDeadzone:r=0
    }

    sensor_cue_z{
      relative:b=yes
    }

    sweep{
      relative:b=yes
    }

    throttle{
      mouseAxisId:i=-1
    }

    vtol{
      keepDisabledValue:b=yes
    }

    weapon_aim_heading{
      relative:b=yes
    }

    zoom{
      kAdd:r=-1
    }
  }

  params{
    USEROPT_ATGM_AIM_SENS_HELICOPTER:i=100
    USEROPT_ATGM_AIM_ZOOM_SENS_HELICOPTER:i=100
    USEROPT_FIX_GUN_IN_MOUSE_LOOK:b=no
    USEROPT_FREE_CAMERA_ZOOM_SPEED:i=50
    USEROPT_GUNNER_VIEW_SENSE:i=100
    USEROPT_GUNNER_VIEW_ZOOM_SENS:i=100
